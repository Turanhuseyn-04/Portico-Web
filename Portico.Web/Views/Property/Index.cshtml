@model PropertyPageVm

@section Styles {
    <link rel="stylesheet" href="~/css/property.css" asp-append-version="true" />
}

<div class="wrap">
    <nav class="crumbs" id="crumbs" aria-label="Breadcrumb">
        <a asp-controller="Home" asp-action="Index">Stays</a>
        <span>@Model.Stay.Address.Country</span>
        <span>@Model.Stay.Address.City</span>
        <span aria-current="page">@Model.Stay.Name</span>
    </nav>
</div>

<article class="property" id="property" data-stay="@Model.Stay.Id" data-name="@Model.Stay.Name">
    @await Component.InvokeAsync("PropertyHead", new { model = Model })
    @await Component.InvokeAsync("PropertyGallery", new { model = Model })
    @await Component.InvokeAsync("PropertySubnav")

    <div class="wrap p-layout">
        <aside class="p-aside" aria-label="Your stay">
            @await Component.InvokeAsync("BookingCard", new { model = Model })
        </aside>
        <div class="p-main">
            @await Component.InvokeAsync("PropertyAbout", new { model = Model })
            @await Component.InvokeAsync("PropertyAmenities", new { model = Model })
            @await Component.InvokeAsync("PropertyRooms", new { model = Model })
            @await Component.InvokeAsync("PropertyReviews", new { model = Model })
            @await Component.InvokeAsync("PropertyLocation", new { model = Model })
            @await Component.InvokeAsync("PropertyHouseRules", new { model = Model })
            @await Component.InvokeAsync("PropertyFaq", new { model = Model })
        </div>
    </div>
</article>

@await Component.InvokeAsync("MobileReserveBar", new { model = Model })
@await Component.InvokeAsync("PropertyLightbox", new { model = Model })

@section Scripts {
    <script src="~/js/property.js" asp-append-version="true"></script>
}
