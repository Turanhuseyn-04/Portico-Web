@{
    ViewData["Title"] = "Stay details";
}

@section Styles {
    <link rel="stylesheet" href="~/css/property.css" asp-append-version="true" />
}

<div class="wrap">
    <nav class="crumbs" id="crumbs" aria-label="Breadcrumb">
        <a asp-controller="Home" asp-action="Index">Stays</a>
    </nav>
</div>

<section class="wrap page-state" id="pageState" hidden aria-live="polite"></section>

<article class="property is-loading" id="property" aria-busy="true" data-reserve="@Url.Action("Reserve", "Property")" data-reservation="@(Url.Action("Index", "Reservation") + "/")" data-trips="@Url.Action("Trips", "Reservation")">
    @await Component.InvokeAsync("PropertyHead")
    @await Component.InvokeAsync("PropertyGallery")
    @await Component.InvokeAsync("PropertySubnav")

    <div class="wrap p-layout">
        <aside class="p-aside" aria-label="Your stay">
            @await Component.InvokeAsync("BookingCard")
        </aside>
        <div class="p-main">
            @await Component.InvokeAsync("PropertyAbout")
            @await Component.InvokeAsync("PropertyAmenities")
            @await Component.InvokeAsync("PropertyRooms")
            @await Component.InvokeAsync("PropertyReviews")
            @await Component.InvokeAsync("PropertyLocation")
            @await Component.InvokeAsync("PropertyHouseRules")
            @await Component.InvokeAsync("PropertyFaq")
        </div>
    </div>
</article>

@await Component.InvokeAsync("MobileReserveBar")
@await Component.InvokeAsync("PropertyLightbox")
@await Component.InvokeAsync("ReserveDialog")

@section Scripts {
    <script src="~/js/mock-properties.js" asp-append-version="true"></script>
    <script src="~/js/api.js" asp-append-version="true"></script>
    <script src="~/js/property.js" asp-append-version="true"></script>
}
