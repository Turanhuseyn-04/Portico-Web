<section class="section results" id="payment" data-asset-root="/assets/" data-reservation="@(Url.Action("Index", "Reservation") + "/")" data-reserve="@Url.Action("Reserve", "Property")" data-home="@Url.Action("Index", "Home")" data-property="@Url.Action("Index", "Property")">
    <div class="wrap">
        <div class="section-head">
            <div>
                <p class="kicker">Payment</p>
                <h1 id="paymentTitle">Payment</h1>
                <p class="sub" id="paymentMeta" aria-live="polite">The same total as the stay, then the card.</p>
            </div>
        </div>
        <div id="paymentBody"></div>
    </div>
</section>

@section Scripts {
    <script src="~/js/mock-properties.js" asp-append-version="true"></script>
    <script src="~/js/api.js" asp-append-version="true"></script>
    <script src="~/js/payment.js" asp-append-version="true" defer></script>
}
