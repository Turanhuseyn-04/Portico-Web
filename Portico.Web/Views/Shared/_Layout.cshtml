<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — Portico</title>
    <meta name="description" content="@(ViewData["Description"] ?? "Portico is a concentrated stay list. Search by city, dates, and guests, then see a total made of nights times the nightly rate.")" />
    <meta name="theme-color" content="#142033" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'%3E%3Crect width='40' height='40' rx='9' fill='%23142033'/%3E%3Cpath fill='none' stroke='%23f4efe6' stroke-width='1.6' stroke-linecap='round' d='M3 34c7.2.2 11.2-6.2 14.2-11.4'/%3E%3Ccircle cx='3.2' cy='34' r='1.55' fill='%23f4efe6'/%3E%3Cg transform='translate(13 1.5) scale(1.12)' fill='%23f4efe6'%3E%3Cpath d='M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z'/%3E%3C/g%3E%3C/svg%3E" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;1,9..144,500&family=Outfit:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@ViewData["BodyClass"]">
    <a class="skip" href="@(ViewData["SkipHref"] ?? "#list")">@(ViewData["SkipText"] ?? "Skip to the list")</a>

    <header class="header@(ViewData["SolidHeader"] as bool? == true ? " is-solid" : "")" id="header">
        <div class="header-inner">
            <a class="logo" asp-controller="Home" asp-action="Index" aria-label="Portico, home">
                <partial name="_Logo" />
            </a>
            <nav class="nav" id="nav">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a asp-controller="Home" asp-action="Types">Properties</a>
                <a asp-controller="Home" asp-action="Destinations">Destinations</a>
                <button class="btn-line" type="button" data-auth="register">Register</button>
                <button class="btn-line btn-fill" type="button" data-auth="signin">Sign in</button>
            </nav>
            <button class="nav-toggle" id="navToggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="nav">
                <span></span><span></span><span></span>
            </button>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="wrap footer-grid">
            <div>
                <a class="logo" asp-controller="Home" asp-action="Index">
                    <partial name="_Logo" />
                </a>
                <p>A concentrated stay list. Search, price, and book one house at a time.</p>
                <a class="footer-reach" href="mailto:hello@portico.example">hello@portico.example</a>
                <a class="footer-reach" href="tel:+442079460958">+44 20 7946 0958</a>
            </div>
            <div>
                <h2>Visit</h2>
                <a href="/#hero">Search</a>
                <a href="/#list">Houses</a>
                <a href="/#notes">Stories</a>
            </div>
            <div>
                <h2>Account</h2>
                <button type="button" data-auth="signin">Sign in</button>
                <button type="button" data-auth="register">Register</button>
            </div>
            <div>
                <h2>This page</h2>
                <p>@(ViewData["FooterNote"] ?? "A design of the home screen. Accounts, holds, and live availability connect when the API is in place.")</p>
            </div>
        </div>
        <div class="wrap legal">
            <p>&copy; 2026 Portico. Photographs from Unsplash, used for this design study.</p>
            <p class="legal-links">
                <a asp-controller="Home" asp-action="Privacy">Privacy</a>
                <a asp-controller="Home" asp-action="Terms">Terms</a>
                <a asp-controller="Home" asp-action="Help">Help</a>
            </p>
        </div>
    </footer>

    <div class="drawer" id="drawer" hidden>
        <button class="backdrop" type="button" data-close="drawer" aria-label="Close details"></button>
        <aside class="drawer-panel" role="dialog" aria-modal="true" aria-labelledby="drawerTitle">
            <button class="icon-x" type="button" data-close="drawer" aria-label="Close">&times;</button>
            <div id="drawerBody"></div>
        </aside>
    </div>

    <div class="modal" id="authModal" hidden>
        <button class="backdrop" type="button" data-close="modal" aria-label="Close dialog"></button>
        <div class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="authTitle">
            <button class="icon-x" type="button" data-close="modal" aria-label="Close">&times;</button>
            <h2 id="authTitle">Sign in</h2>
            <p class="auth-lede" id="authLede">Use the same door you will use when the API is connected.</p>
            <form id="authForm">
                <label class="stack" id="authNameWrap" hidden>Full name
                    <input id="authName" name="name" type="text" autocomplete="name" />
                </label>
                <label class="stack">Email
                    <input name="email" type="email" required autocomplete="email" />
                </label>
                <label class="stack">Password
                    <input name="password" type="password" required minlength="8" autocomplete="current-password" />
                </label>
                <button class="search-btn auth-submit" id="authSubmit" type="submit">Sign in</button>
                <button class="text-btn" id="authSwitch" type="button">New here? Create an account</button>
            </form>
            <p id="authDone" hidden></p>
        </div>
    </div>

    <div class="toast" id="toast" role="status"></div>
    <script>document.documentElement.classList.add("js");</script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
