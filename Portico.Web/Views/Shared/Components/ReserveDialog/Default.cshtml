<div class="modal" id="reserveModal" hidden>
    <button class="backdrop" type="button" data-close="reserve" aria-label="Close dialog"></button>
    <div class="modal-panel reserve-panel" role="dialog" aria-modal="true" aria-labelledby="reserveTitle">
        <button class="icon-x" type="button" data-close="reserve" aria-label="Close">&times;</button>
        <div id="reserveStep">
            <h2 id="reserveTitle">Confirm your stay</h2>
            <div class="reserve-summary" id="reserveSummary"></div>
            <form id="reserveForm" novalidate>
                <label class="stack">Full name
                    <input name="name" type="text" required autocomplete="name" aria-describedby="reserveNameError">
                    <span class="field-error" id="reserveNameError"></span>
                </label>
                <label class="stack">Email
                    <input name="email" type="email" required autocomplete="email" aria-describedby="reserveEmailError">
                    <span class="field-error" id="reserveEmailError"></span>
                </label>
                <label class="stack"><span>Phone <em class="optional">optional</em></span>
                    <input name="phone" type="tel" autocomplete="tel">
                </label>
                <label class="stack"><span>Requests for the property <em class="optional">optional</em></span>
                    <textarea name="requests" rows="3" maxlength="400"></textarea>
                </label>
                <p class="reserve-error" id="reserveError" role="alert"></p>
                <button class="search-btn auth-submit" id="reserveSubmit" type="submit">Confirm reservation</button>
                <p class="preview-note">Preview only. No payment is taken and nothing is charged.</p>
            </form>
        </div>
        <div class="reserve-done" id="reserveDone" hidden tabindex="-1"></div>
    </div>
</div>
