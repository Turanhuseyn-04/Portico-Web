@model IReadOnlyList<Portico.Web.ViewModels.Videos.VideoVm>
@* The videos an admin manages, in their order. Hidden, not left out, when there are none: home.js expects the section. *@
<section class="video-slider" id="videoSlider" aria-labelledby="videoTitle" hidden="@(Model.Count == 0)">
    <div class="wrap">
        <div class="section-head reveal">
            <h2 id="videoTitle">Some places stay with you</h2>
        </div>
    </div>
    <div class="video-band">
        <div class="video-track" id="videoTrack">
            @foreach (var video in Model)
            {
                <div class="video-slide"><video src="@video.Src" muted loop playsinline preload="metadata" disablepictureinpicture aria-hidden="true"></video></div>
            }
        </div>
    </div>
    <div class="video-dots" id="videoDots" hidden="@(Model.Count < 2)">
        @for (var i = 0; i < Model.Count; i++)
        {
            <button type="button" class="@(i == 0 ? "is-on" : null)" aria-label="Video @(i + 1)" aria-current="@(i == 0 ? "true" : null)"></button>
        }
    </div>
</section>
