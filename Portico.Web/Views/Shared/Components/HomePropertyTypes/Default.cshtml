<section class="section" id="properties" aria-labelledby="propertyTitle">
    <div class="wrap">
        <div class="section-head reveal">
            <div>
                <p class="kicker">Property type</p>
                <h2 id="propertyTitle">Find Your Place in the World</h2>
                <p class="sub">Discover exceptional stays, from boutique hotels to private villas.</p>
                <p class="property-kinds">Hotels · Apartments · Resorts · Villas</p>
            </div>
        </div>
        <div class="properties" id="propertiesGrid">
            <button class="property-card reveal" type="button" data-property="Hotel" aria-pressed="false">
                <img src="/assets/hotel.jpg" alt="">
                <strong>Hotels</strong>
            </button>
            <button class="property-card reveal" type="button" data-property="Apartment" aria-pressed="false">
                <img src="/assets/apartment.jpg" alt="">
                <strong>Apartments</strong>
            </button>
            <button class="property-card reveal" type="button" data-property="Resort" aria-pressed="false">
                <img src="/assets/resort.jpg" alt="">
                <strong>Resorts</strong>
            </button>
            <button class="property-card reveal" type="button" data-property="Villa" aria-pressed="false">
                <img src="/assets/villa.jpg" alt="">
                <strong>Villas</strong>
            </button>
        </div>
    </div>
</section>
