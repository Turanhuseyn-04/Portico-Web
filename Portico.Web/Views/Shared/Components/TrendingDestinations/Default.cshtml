@model List<DestinationVm>
<section class="section" id="trending" aria-labelledby="trendTitle">
    <div class="wrap">
        <div class="section-head reveal">
            <div>
                <p class="kicker">Trending</p>
                <h2 id="trendTitle">Top trending destinations</h2>
            </div>
            <div class="arrows">
                <button type="button" id="trendPrev" aria-label="Previous destinations">←</button>
                <button type="button" id="trendNext" aria-label="Next destinations">→</button>
            </div>
        </div>
        <div class="trend-viewport">
            <div class="trend-track reveal-track" id="trendTrack" tabindex="0" aria-label="Top trending destinations">
                @foreach (var place in Model)
                {
                    <article class="trend-card" data-city="@place.City" tabindex="0" role="button" aria-label="Search stays in @place.City">
                        <img src="@place.Image" alt="" width="800" height="1000">
                        <div class="shade"></div>
                        <div class="trend-meta">
                            <h3>@place.City</h3>
                        </div>
                    </article>
                }
            </div>
        </div>
    </div>
</section>
