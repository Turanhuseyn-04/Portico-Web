<div class="lightbox" id="lightbox" hidden>
    <div class="lightbox-panel" role="dialog" aria-modal="true" aria-label="Photo gallery">
        <div class="lb-top">
            <p id="lbCount" aria-live="polite"></p>
            <button class="lb-close" type="button" data-close="lightbox" aria-label="Close gallery">&times;</button>
        </div>
        <figure class="lb-stage" id="lbStage">
            <button class="lb-nav lb-prev" id="lbPrev" type="button" aria-label="Previous photo">&larr;</button>
            <img id="lbImage" src="data:," alt="">
            <button class="lb-nav lb-next" id="lbNext" type="button" aria-label="Next photo">&rarr;</button>
            <figcaption id="lbCaption"></figcaption>
        </figure>
        <div class="lb-thumbs" id="lbThumbs"></div>
    </div>
</div>
