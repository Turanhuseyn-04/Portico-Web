@model HeroSearchVm
<section class="hero" id="hero">
    <div class="hero-slides" id="heroSlides" aria-hidden="true">
        <div class="hero-slide is-on" style="background-image: url('/assets/hero.jpg')"></div>
        <div class="hero-slide" style="background-image: url('/assets/amalfi.jpg')"></div>
        <div class="hero-slide" style="background-image: url('/assets/lisbon.jpg')"></div>
        <div class="hero-slide" style="background-image: url('/assets/kyoto.jpg')"></div>
    </div>
    <div class="wrap">
        <div class="hero-copy">
            <p class="kicker"><span>Stays, without the noise</span></p>
            <h1>Fewer choices,<br>Better stays</h1>
            <p class="lede">Discover exceptional places to stay, carefully selected for your next getaway.</p>
        </div>

        <form class="search" id="searchForm" method="get" asp-controller="Home" asp-action="Search" aria-describedby="formError" data-types="@Url.Action("Types", "Home")">
            <input type="hidden" name="checkIn" id="checkInValue">
            <input type="hidden" name="checkOut" id="checkOutValue">
            <input type="hidden" name="adults" id="adultsValue" value="2">
            <input type="hidden" name="children" id="childrenValue" value="0">
            <input type="hidden" name="rooms" id="roomsValue" value="1">
            <input type="hidden" name="property" id="propertyValue" value="@Model.Property">
            <div class="search-fields">
                <div class="field" id="whereField">
                    <label class="field-label" for="whereInput">Destination</label>
                    <input id="whereInput" name="destination" type="text" placeholder="Where are you going?" autocomplete="off" aria-autocomplete="list" aria-controls="wherePopover" aria-expanded="false">
                </div>
                <div class="dates" id="datesField">
                    <div class="field">
                        <span class="field-label" id="checkInLabel">Check-in</span>
                        <button class="field-value is-empty" id="checkInBtn" type="button" aria-labelledby="checkInLabel" aria-controls="calPopover" aria-expanded="false">Add date</button>
                    </div>
                    <div class="field">
                        <span class="field-label" id="checkOutLabel">Check-out</span>
                        <button class="field-value is-empty" id="checkOutBtn" type="button" aria-labelledby="checkOutLabel" aria-controls="calPopover" aria-expanded="false">Add date</button>
                    </div>
                </div>
                <div class="field" id="guestField">
                    <span class="field-label" id="guestLabel">Guests</span>
                    <button class="field-value" id="guestBtn" type="button" aria-labelledby="guestLabel" aria-controls="guestPopover" aria-expanded="false">2 adults · 1 room</button>
                </div>
            </div>
            <button class="search-btn" type="submit">
                Search
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                    <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>

            <div class="popover" id="wherePopover" hidden>
                <div class="where-box" role="listbox">
                    @foreach (var place in Model.Places)
                    {
                        <button class="where-item" type="button" data-city="@place.City" data-country="@place.Country" role="option">
                            <span class="pin" aria-hidden="true"></span>
                            <span><strong>@place.City</strong><em>@place.Country · @StayText.Count(place.Count, "house", "houses")</em></span>
                        </button>
                    }
                    <p class="where-empty" hidden>No city on the list matches that.</p>
                </div>
            </div>
            <div class="popover" id="calPopover" hidden></div>
            <div class="popover guest-popover" id="guestPopover" hidden>
                <div class="guest-box">
                    <div class="guest-row">
                        <div>
                            <strong>Adults</strong>
                            <em>Ages 18 and over</em>
                        </div>
                        <div class="stepper">
                            <button type="button" data-step="adults" data-dir="-1" aria-label="Remove an adult">−</button>
                            <span id="adultsCount">2</span>
                            <button type="button" data-step="adults" data-dir="1" aria-label="Add an adult">+</button>
                        </div>
                    </div>
                    <div class="guest-row">
                        <div>
                            <strong>Children</strong>
                            <em>Ages 0–17</em>
                        </div>
                        <div class="stepper">
                            <button type="button" data-step="children" data-dir="-1" aria-label="Remove a child">−</button>
                            <span id="childrenCount">0</span>
                            <button type="button" data-step="children" data-dir="1" aria-label="Add a child">+</button>
                        </div>
                    </div>
                    <div class="guest-row">
                        <div>
                            <strong>Rooms</strong>
                            <em>Physical rooms</em>
                        </div>
                        <div class="stepper">
                            <button type="button" data-step="rooms" data-dir="-1" aria-label="Remove a room">−</button>
                            <span id="roomsCount">1</span>
                            <button type="button" data-step="rooms" data-dir="1" aria-label="Add a room">+</button>
                        </div>
                    </div>
                    <p class="guest-note">The stay total is nightly rate × nights × rooms.</p>
                    <button class="guest-done" type="button" data-close-guests>Done</button>
                </div>
            </div>
        </form>
        <p class="form-error" id="formError" role="alert"></p>
        <p class="fine">Stay total = nights × nightly rate × rooms.</p>
        <div class="chips" id="chips">
            <button class="chip" type="button" data-city="Lisbon">Lisbon</button>
            <button class="chip" type="button" data-city="Kyoto">Kyoto</button>
            <button class="chip" type="button" data-city="Copenhagen">Copenhagen</button>
            <button class="chip" type="button" data-city="Marrakech">Marrakech</button>
            <button class="chip" type="button" data-city="Amalfi">Amalfi</button>
            <button class="chip" type="button" data-city="Oaxaca">Oaxaca</button>
        </div>
    </div>
</section>
