@{
    ViewData["Title"] = "Property types";
    ViewData["Description"] = "Hotels, apartments, resorts, and villas on the Portico list.";
    ViewData["BodyClass"] = "results-page";
    ViewData["SolidHeader"] = true;
    ViewData["SkipHref"] = "#types";
    ViewData["SkipText"] = "Skip to property types";
    ViewData["FooterNote"] = "Each type opens the stays of that kind. The filter on this page is a preview until Portico.Api supplies it.";
}

<section class="section results" id="types" data-asset-root="/assets/" data-property="@Url.Action("Index", "Property")">
    <div class="wrap">
        <div class="section-head">
            <div>
                <p class="kicker">Property type</p>
                <h1 id="typeTitle">All property types</h1>
                <p class="sub" id="typeMeta" aria-live="polite">The stays for hotels, apartments, resorts, and villas.</p>
            </div>
        </div>
        <div class="destination-filters">
            <label class="sort">Type
                <select id="typePick">
                    <option value="">All types</option>
                    <option value="Hotel">Hotels</option>
                    <option value="Apartment">Apartments</option>
                    <option value="Resort">Resorts</option>
                    <option value="Villa">Villas</option>
                </select>
            </label>
            <label class="stack">Stay or city
                <input id="typeFilter" type="search" placeholder="Name or city" autocomplete="off">
            </label>
        </div>
        <div id="stayList"></div>
    </div>
</section>

@section Scripts {
    <script src="~/js/types.js" asp-append-version="true" defer></script>
}
