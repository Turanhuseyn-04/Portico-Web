@model HomeVm
@{
    ViewData["Title"] = "A shorter list of stays";
}

@await Component.InvokeAsync("HeroSearch", new { model = Model.Search })
@await Component.InvokeAsync("TrendingDestinations", new { model = Model.Destinations })
@await Component.InvokeAsync("HomePropertyTypes")
@await Component.InvokeAsync("StayRules")
@await Component.InvokeAsync("StayList", new { model = Model.List })
@await Component.InvokeAsync("VideoBand")
@await Component.InvokeAsync("GuestNotes")
@await Component.InvokeAsync("CloseBand")

@section Scripts {
    <script src="~/js/home.js" asp-append-version="true" defer></script>
}
