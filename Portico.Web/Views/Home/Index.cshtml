@{
    ViewData["Title"] = "A shorter list of stays";
}

<section class="hero" id="hero">
    <div class="wrap">
        <div class="hero-copy">
            <p class="kicker"><span>Stays, without the noise</span></p>
            <h1>Fewer choices,<br>Better stays</h1>
            <p class="lede">Discover exceptional places to stay, carefully selected for your next getaway.</p>
        </div>

        <form class="search" id="searchForm" aria-describedby="formError">
            <div class="search-fields">
                <div class="field" id="whereField">
                    <label class="field-label" for="whereInput">Destination</label>
                    <input id="whereInput" name="destination" type="text" placeholder="Where are you going?" autocomplete="off" aria-autocomplete="list" aria-controls="wherePopover" aria-expanded="false">
                </div>
                <div class="dates" id="datesField">
                    <div class="field">
                        <span class="field-label" id="checkInLabel">Check-in</span>
                        <button class="field-value is-empty" id="checkInBtn" type="button" aria-labelledby="checkInLabel" aria-controls="calPopover" aria-expanded="false">Add date</button>
                    </div>
                    <div class="field">
                        <span class="field-label" id="checkOutLabel">Check-out</span>
                        <button class="field-value is-empty" id="checkOutBtn" type="button" aria-labelledby="checkOutLabel" aria-controls="calPopover" aria-expanded="false">Add date</button>
                    </div>
                </div>
                <div class="field" id="guestField">
                    <span class="field-label" id="guestLabel">Guests</span>
                    <button class="field-value" id="guestBtn" type="button" aria-labelledby="guestLabel" aria-controls="guestPopover" aria-expanded="false">2 adults · 1 room</button>
                </div>
            </div>
            <button class="search-btn" type="submit">
                Search
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                    <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>

            <div class="popover" id="wherePopover" hidden></div>
            <div class="popover" id="calPopover" hidden></div>
            <div class="popover guest-popover" id="guestPopover" hidden>
                <div class="guest-box">
                    <div class="guest-row">
                        <div>
                            <strong>Adults</strong>
                            <em>Ages 18 and over</em>
                        </div>
                        <div class="stepper">
                            <button type="button" data-step="adults" data-dir="-1" aria-label="Remove an adult">−</button>
                            <span id="adultsCount">2</span>
                            <button type="button" data-step="adults" data-dir="1" aria-label="Add an adult">+</button>
                        </div>
                    </div>
                    <div class="guest-row">
                        <div>
                            <strong>Children</strong>
                            <em>Ages 0–17</em>
                        </div>
                        <div class="stepper">
                            <button type="button" data-step="children" data-dir="-1" aria-label="Remove a child">−</button>
                            <span id="childrenCount">0</span>
                            <button type="button" data-step="children" data-dir="1" aria-label="Add a child">+</button>
                        </div>
                    </div>
                    <div class="guest-row">
                        <div>
                            <strong>Rooms</strong>
                            <em>Physical rooms</em>
                        </div>
                        <div class="stepper">
                            <button type="button" data-step="rooms" data-dir="-1" aria-label="Remove a room">−</button>
                            <span id="roomsCount">1</span>
                            <button type="button" data-step="rooms" data-dir="1" aria-label="Add a room">+</button>
                        </div>
                    </div>
                    <p class="guest-note">The stay total is nightly rate × nights × rooms.</p>
                    <button class="guest-done" type="button" data-close-guests>Done</button>
                </div>
            </div>
        </form>
        <p class="form-error" id="formError" role="alert"></p>
        <p class="fine">Stay total = nights × nightly rate × rooms.</p>
        <div class="chips" id="chips">
            <button class="chip" type="button" data-city="Lisbon">Lisbon</button>
            <button class="chip" type="button" data-city="Kyoto">Kyoto</button>
            <button class="chip" type="button" data-city="Copenhagen">Copenhagen</button>
            <button class="chip" type="button" data-city="Marrakech">Marrakech</button>
            <button class="chip" type="button" data-city="Amalfi">Amalfi</button>
            <button class="chip" type="button" data-city="Oaxaca">Oaxaca</button>
        </div>
    </div>
</section>

<section class="section" id="trending" aria-labelledby="trendTitle">
    <div class="wrap">
        <div class="section-head reveal">
            <div>
                <p class="kicker">Trending</p>
                <h2 id="trendTitle">Top trending destinations</h2>
            </div>
            <div class="arrows">
                <button type="button" id="trendPrev" aria-label="Previous destinations">←</button>
                <button type="button" id="trendNext" aria-label="Next destinations">→</button>
            </div>
        </div>
        <div class="trend-viewport">
            <div class="trend-track reveal-track" id="trendTrack" tabindex="0" aria-label="Top trending destinations"></div>
        </div>
    </div>
</section>

<section class="section" id="properties" aria-labelledby="propertyTitle">
    <div class="wrap">
        <div class="section-head reveal">
            <div>
                <p class="kicker">Property type</p>
                <h2 id="propertyTitle">Find Your Place in the World</h2>
                <p class="sub">Discover exceptional stays, from boutique hotels to private villas.</p>
                <p class="property-kinds">Hotels · Apartments · Resorts · Villas</p>
            </div>
        </div>
        <div class="properties" id="propertiesGrid">
            <button class="property-card reveal" type="button" data-property="Hotel" aria-pressed="false">
                <img src="~/assets/hotel.jpg" alt="">
                <strong>Hotels</strong>
            </button>
            <button class="property-card reveal" type="button" data-property="Apartment" aria-pressed="false">
                <img src="~/assets/apartment.jpg" alt="">
                <strong>Apartments</strong>
            </button>
            <button class="property-card reveal" type="button" data-property="Resort" aria-pressed="false">
                <img src="~/assets/resort.jpg" alt="">
                <strong>Resorts</strong>
            </button>
            <button class="property-card reveal" type="button" data-property="Villa" aria-pressed="false">
                <img src="~/assets/villa.jpg" alt="">
                <strong>Villas</strong>
            </button>
        </div>
    </div>
</section>

<section class="offer-band" id="rules" aria-labelledby="rulesTitle">
    <div class="wrap">
        <div class="section-head reveal">
            <div>
                <p class="kicker">How the price works</p>
                <h2 id="rulesTitle">Three rules, said out loud</h2>
            </div>
        </div>
        <div class="offers">
            <article class="offer reveal">
                <span>01</span>
                <h3>The total is nights times rate</h3>
                <p>Search with dates and a card switches from a nightly rate to the stay total. The sum is on the card before you continue.</p>
            </article>
            <article class="offer reveal">
                <span>02</span>
                <h3>Cancellation is a date</h3>
                <p>Free cancellation runs until three days before check-in, and only on houses that offer it. Others say non-refundable.</p>
            </article>
            <article class="offer reveal">
                <span>03</span>
                <h3>If it cannot sleep you, it says so</h3>
                <p>A house stays on the list when the group is too large. It does not pretend the room still fits.</p>
            </article>
        </div>
    </div>
</section>

<section class="section" id="list" aria-labelledby="listTitle">
    <div class="wrap">
        <div class="section-head reveal">
            <div>
                <p class="kicker">The list</p>
                <h2 id="listTitle">Top properties to stay</h2>
                <p class="sub" id="listMeta" aria-live="polite"></p>
            </div>
            <label class="sort">Sort
                <select id="sort">
                    <option value="featured">Featured</option>
                    <option value="price">Price</option>
                    <option value="rating">Guest rating</option>
                </select>
            </label>
        </div>
        <div id="stayList"></div>
    </div>
</section>

<section class="video-slider" id="videoSlider" aria-labelledby="videoTitle">
    <div class="wrap">
        <div class="section-head reveal">
            <h2 id="videoTitle">Some places stay with you</h2>
        </div>
    </div>
    <div class="video-band">
        <div class="video-track" id="videoTrack">
            <div class="video-slide"><video src="~/assets/videos/villas/14041585_1920_1080_25fps.mp4" muted loop playsinline preload="metadata" disablepictureinpicture aria-hidden="true"></video></div>
            <div class="video-slide"><video src="~/assets/videos/resorts/3576398-uhd_3840_2160_25fps.mp4" muted loop playsinline preload="metadata" disablepictureinpicture aria-hidden="true"></video></div>
        </div>
    </div>
    <div class="video-dots" id="videoDots">
        <button type="button" class="is-on" aria-label="Video 1" aria-current="true"></button>
        <button type="button" aria-label="Video 2"></button>
    </div>
</section>

<section class="section" id="notes" aria-labelledby="notesTitle">
    <div class="wrap">
        <div class="section-head reveal">
            <div>
                <p class="kicker">After checkout</p>
                <h2 id="notesTitle">What guests mention</h2>
            </div>
        </div>
        <div class="notes">
            <figure class="note reveal">
                <blockquote>“The photo was the room. That is rarer than the big sites admit.”</blockquote>
                <figcaption>
                    <span class="score">9.6</span>
                    <span><strong>Ivo P.</strong> The Marble Court</span>
                </figcaption>
            </figure>
            <figure class="note reveal">
                <blockquote>“We changed the dates and the price changed in front of us.”</blockquote>
                <figcaption>
                    <span class="score">9.2</span>
                    <span><strong>Lena S.</strong> Greenhouse No. 4</span>
                </figcaption>
            </figure>
            <figure class="note reveal">
                <blockquote>“Cancelled on the Tuesday. The rule was written down, and they kept it.”</blockquote>
                <figcaption>
                    <span class="score">9.4</span>
                    <span><strong>Samir A.</strong> Riad of Small Doors</span>
                </figcaption>
            </figure>
        </div>
    </div>
</section>

<section class="close-band" aria-labelledby="closeTitle">
    <div class="wrap reveal">
        <p class="kicker">Before you open another tab</p>
        <h2 id="closeTitle">If it is not on this list, we are not selling it</h2>
        <a class="btn-copper" href="#hero">Search the list</a>
    </div>
</section>
