@{
    var reference = ViewData["Reference"] as string ?? "";
}

<section class="section results" id="cancel" data-asset-root="/assets/" data-reservation="@(Url.Action("Index", "Reservation") + "/")" data-cancel="@Url.Action("Index", "Reservation")" data-trips="@Url.Action("Trips", "Reservation")" data-reference="@reference">
    <div class="wrap">
        <div class="section-head">
            <div>
                <p class="kicker">Reservation</p>
                <h1 id="cancelTitle">Cancel this reservation</h1>
                <p class="sub" id="cancelMeta">The stay, the deadline, and what happens to the total.</p>
            </div>
        </div>
        <div id="cancelBody"></div>
    </div>
</section>

@section Scripts {
    <script src="~/js/api.js" asp-append-version="true" defer></script>
    <script src="~/js/cancel.js" asp-append-version="true" defer></script>
}
