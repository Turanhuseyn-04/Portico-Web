<section class="section results" id="trips" data-asset-root="/assets/" data-reservation="@(Url.Action("Index", "Reservation") + "/")">
    <div class="wrap">
        <div class="section-head">
            <div>
                <p class="kicker">Account</p>
                <h1>Your trips</h1>
                <p class="sub" id="tripsMeta" aria-live="polite">The stays reserved in this browser.</p>
            </div>
        </div>
        <div id="tripList"></div>
    </div>
</section>

@section Scripts {
    <script src="~/js/api.js" asp-append-version="true" defer></script>
    <script src="~/js/trips.js" asp-append-version="true" defer></script>
}
