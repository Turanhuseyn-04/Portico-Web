@{
    var mode = ViewData["Mode"] as string ?? "signin";
    var failed = ViewData["Failed"] as bool? == true;
    var email = ViewData["Email"] as string ?? "";
    var register = mode == "register";
}

<section class="section results" id="account" data-mode="@mode" data-failed="@(failed ? "true" : "false")" data-failed-url="@Url.Action("SignInFailed", "Account")">
    <div class="wrap">
        <p class="kicker">Account</p>
        @if (register)
        {
            <h1 id="accountTitle">Create an account</h1>
            <p class="sub">Guests book stays. Admins run the houses. This preview stores nothing.</p>
        }
        else
        {
            <h1 id="accountTitle">@(failed ? "Sign in failed" : "Sign in")</h1>
            <p class="sub">Use the same door you will use when the API is connected.</p>
        }
        <div class="account-panel">
            @if (!register)
            {
                <p class="account-error" id="accountError" role="alert" @(failed ? null : "hidden")>That email and password did not match. Nothing was signed in.</p>
            }
            <form id="accountForm">
                @if (register)
                {
                    <label class="stack">Full name
                        <input name="name" type="text" required minlength="2" autocomplete="name" />
                    </label>
                }
                <label class="stack">Email
                    <input name="email" type="email" required autocomplete="@(register ? "email" : "username")" value="@email" />
                </label>
                <label class="stack">Password
                    <input name="password" type="password" required minlength="8" autocomplete="@(register ? "new-password" : "current-password")" />
                </label>
                <button class="search-btn auth-submit" type="submit">@(register ? "Create account" : "Sign in")</button>
            </form>
            <p id="accountDone" hidden></p>
            @if (register)
            {
                <a class="account-switch" asp-controller="Account" asp-action="SignIn">Already on the list? Sign in</a>
            }
            else
            {
                <a class="account-switch" asp-controller="Account" asp-action="Register">New here? Create an account</a>
            }
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/account.js" asp-append-version="true" defer></script>
}
