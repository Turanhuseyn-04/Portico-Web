@model SlideFormVm
<section id="slideForm">
    <header class="desk-head">
        <div>
            <h1>Edit slide</h1>
            <p>A trending destination on the home page. Choose its photo from your computer.</p>
        </div>
    </header>
    <form class="editor" asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="All"></div>
        <partial name="_Fields" model="Model" />
        <div class="editor-actions">
            <button class="btn-ink" type="submit">Save</button>
            <a asp-action="Index">Cancel</a>
        </div>
    </form>
</section>
