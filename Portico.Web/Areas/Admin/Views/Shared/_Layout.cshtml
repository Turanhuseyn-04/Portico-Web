@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var section = ViewData["Console"] as string ?? "";
    string? Current(string name) => section == name ? "page" : null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — Portico Admin</title>
    <meta name="description" content="@(ViewData["Description"] ?? "Reservations, stays, and users for the person who runs the houses.")" />
    <meta name="theme-color" content="#142033" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'%3E%3Crect width='40' height='40' rx='9' fill='%23142033'/%3E%3Cpath fill='none' stroke='%23f4efe6' stroke-width='1.6' stroke-linecap='round' d='M3 34c7.2.2 11.2-6.2 14.2-11.4'/%3E%3Ccircle cx='3.2' cy='34' r='1.55' fill='%23f4efe6'/%3E%3Cg transform='translate(13 1.5) scale(1.12)' fill='%23f4efe6'%3E%3Cpath d='M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z'/%3E%3C/g%3E%3C/svg%3E" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;1,9..144,500&family=Outfit:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
@using Portico.Web.Models.Accounts
<body class="@ViewData["BodyClass"]" data-account-name="@User.DisplayName()" data-account-email="@User.Email()">
    <a class="skip" href="@(ViewData["SkipHref"] ?? "#adminDesk")">@(ViewData["SkipText"] ?? "Skip to the dashboard")</a>
    <div class="console">
        <aside class="console-side" id="consoleSide">
            <a class="console-brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                <partial name="_Logo" />
                <span>Admin</span>
            </a>
            <nav class="console-nav" aria-label="Admin">
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" aria-current="@Current("Dashboard")">Dashboard</a>
                <a asp-area="Admin" asp-controller="Reservation" asp-action="Index" asp-route-id="" aria-current="@Current("Reservations")">Reservations <span class="side-count" id="sideReservationCount"></span></a>
                <a asp-area="Admin" asp-controller="Availability" asp-action="Index" asp-route-id="" aria-current="@Current("Availability")">Availability</a>
                <a asp-area="Admin" asp-controller="Stay" asp-action="Index" asp-route-id="" aria-current="@Current("Stays")">Stays <span class="side-count" id="sideStayCount"></span></a>
                <a asp-area="Admin" asp-controller="Reviews" asp-action="Index" asp-route-id="" aria-current="@Current("Reviews")">Reviews</a>
                <a asp-area="Admin" asp-controller="Slides" asp-action="Index" aria-current="@Current("Slides")">Slides</a>
                <a asp-area="Admin" asp-controller="Videos" asp-action="Index" aria-current="@Current("Videos")">Videos</a>
                <a asp-area="Admin" asp-controller="Report" asp-action="Index" aria-current="@Current("Report")">Report</a>
                <a asp-area="Admin" asp-controller="Messages" asp-action="Index" aria-current="@Current("Messages")">Messages <span class="side-count" id="sideMessageCount"></span></a>
                <a asp-area="Admin" asp-controller="Users" asp-action="Index" aria-current="@Current("Users")">Users <span class="side-count" id="sideUserCount"></span></a>
                @if (User.IsSuperAdmin())
                {
                    <a asp-area="Admin" asp-controller="Accounts" asp-action="Index" aria-current="@Current("Accounts")">Accounts</a>
                    <a asp-area="Admin" asp-controller="Settings" asp-action="Index" aria-current="@Current("Settings")">Settings</a>
                    <a asp-area="Admin" asp-controller="Audit" asp-action="Index" aria-current="@Current("Audit")">Audit log</a>
                }
            </nav>
            <p class="console-role">Signed in as @User.Role()</p>
            <a class="console-leave" asp-area="" asp-controller="Home" asp-action="Index">Guest site</a>
        </aside>
        <div class="console-main">
            <header class="console-top">
                <button class="console-menu" id="consoleMenu" type="button" aria-label="Open admin menu" aria-expanded="false" aria-controls="consoleSide">
                    <span></span><span></span><span></span>
                </button>
                <div>
                    <p class="console-kicker">Portico</p>
                    <p class="console-title">@ViewData["Title"]</p>
                </div>
            </header>
            <div class="console-body">
                @RenderBody()
            </div>
        </div>
    </div>
    <script>
        document.documentElement.classList.add("js");
        (function () {
            var side = document.getElementById("consoleSide");
            var toggle = document.getElementById("consoleMenu");
            if (!side || !toggle) return;
            toggle.addEventListener("click", function () {
                var open = side.classList.toggle("is-open");
                toggle.setAttribute("aria-expanded", String(open));
                toggle.setAttribute("aria-label", open ? "Close admin menu" : "Open admin menu");
            });
            side.addEventListener("click", function (event) {
                if (event.target.closest("a")) side.classList.remove("is-open");
            });
        })();
    </script>
    <script src="~/js/mock-properties.js" asp-append-version="true"></script>
    <script src="~/js/api.js" asp-append-version="true"></script>
    @* The console's scripts go through the Web, which adds the API token; a change carries the anti-forgery token. *@
    <script>
        PorticoApi.config.baseUrl = "@Url.Content("~/Admin/api")";
        PorticoApi.config.headers = { "RequestVerificationToken": "@Antiforgery.GetAndStoreTokens(Context).RequestToken" };
    </script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    <script src="~/js/admin-console.js" asp-append-version="true"></script>
    <script src="~/js/admin-content.js" asp-append-version="true"></script>
</body>
</html>
