<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — Portico</title>
    <meta name="description" content="@(ViewData["Description"] ?? "The houses, the reservations, and the account kept in this browser.")" />
    <meta name="theme-color" content="#142033" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'%3E%3Crect width='40' height='40' rx='9' fill='%23142033'/%3E%3Cpath fill='none' stroke='%23f4efe6' stroke-width='1.6' stroke-linecap='round' d='M3 34c7.2.2 11.2-6.2 14.2-11.4'/%3E%3Ccircle cx='3.2' cy='34' r='1.55' fill='%23f4efe6'/%3E%3Cg transform='translate(13 1.5) scale(1.12)' fill='%23f4efe6'%3E%3Cpath d='M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z'/%3E%3C/g%3E%3C/svg%3E" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;1,9..144,500&family=Outfit:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
</head>
<body class="@ViewData["BodyClass"]">
    <a class="skip" href="@(ViewData["SkipHref"] ?? "#admin")">@(ViewData["SkipText"] ?? "Skip to admin")</a>

    <header class="header is-solid" id="header">
        <div class="header-inner">
            <a class="logo" asp-area="Admin" asp-controller="Dashboard" asp-action="Index" aria-label="Portico admin">
                <partial name="_Logo" />
            </a>
            <nav class="nav" id="nav">
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" aria-current="@(ViewContext.RouteData.Values["controller"] as string == "Dashboard" ? "page" : null)">Dashboard</a>
                <a asp-area="" asp-controller="Home" asp-action="Index">Guest site</a>
            </nav>
            <button class="nav-toggle" id="navToggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="nav">
                <span></span><span></span><span></span>
            </button>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="wrap footer-grid">
            <div>
                <a class="logo" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                    <partial name="_Logo" />
                </a>
                <p>The houses and the reservations. The guest site stays on its own layout.</p>
            </div>
            <div>
                <h2>Admin</h2>
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                <a asp-area="" asp-controller="Reservation" asp-action="Trips">Your trips</a>
            </div>
            <div>
                <h2>Guest site</h2>
                <a asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                <a asp-area="" asp-controller="Account" asp-action="SignIn">Sign in</a>
                <a asp-area="" asp-controller="Account" asp-action="Register">Register</a>
            </div>
            <div>
                <h2>This page</h2>
                <p>@(ViewData["FooterNote"] ?? "Reservations and stays for the person who runs the houses.")</p>
            </div>
        </div>
        <div class="wrap legal">
            <p>&copy; 2026 Portico. Photographs from Unsplash, used for this design study.</p>
            <p class="legal-links">
                <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                <a asp-area="" asp-controller="Home" asp-action="Terms">Terms</a>
                <a asp-area="" asp-controller="Home" asp-action="Help">Help</a>
            </p>
        </div>
    </footer>

    <script>document.documentElement.classList.add("js");</script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
