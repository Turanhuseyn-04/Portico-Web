@model VideoFormVm
<section id="videoForm">
    <header class="desk-head">
        <div>
            <h1>New video</h1>
            <p>A video in the home page band. Choose the file from your computer.</p>
        </div>
    </header>
    <form class="editor" asp-action="Create" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="All"></div>
        <partial name="_Fields" />
        <div class="editor-actions">
            <button class="btn-ink" type="submit">Create</button>
            <a asp-action="Index">Cancel</a>
        </div>
    </form>
</section>
