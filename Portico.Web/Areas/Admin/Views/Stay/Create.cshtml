@model StayFormVm
<section id="stayForm">
    <header class="desk-head">
        <div>
            <h1>New stay</h1>
            <p>The id is a short slug, such as marble. A blank room row is ignored.</p>
        </div>
    </header>
    <form class="editor" asp-action="Create" method="post">
        <div asp-validation-summary="All"></div>
        <partial name="_Fields" />
        <div class="editor-actions">
            <button class="btn-ink" type="submit">Create</button>
            <a asp-action="Index">Cancel</a>
        </div>
    </form>
</section>
