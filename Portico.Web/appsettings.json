{
  "ApiSettings": {
    "BaseUrl": "https://localhost:7190"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "LogFiles": {
    "Directory": "logs",
    "RetainedDays": 14
  },
  "AllowedHosts": "*"
}
